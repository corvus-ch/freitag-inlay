%!TEX encoding = UTF-8 Unicode
\ProvidesPackage{inlay}

\RequirePackage{scrlayer-scrpage}

% ==========
% Dimensions
% ----------

\setlength\parindent{0pt}

\PassOptionsToPackage{
	ignoreall,
	inner=14mm,
	layoutheight=182mm,
	layouthoffset=16.5mm, % (a5width - layoutwidth) / 2
	layoutvoffset=14mm, % (a5height - layoutheight) / 2
	layoutwidth=115mm,
	outer=9mm,
	paper=a5paper,
	showcrop,
	twoside,
	vmargin=5mm,
}{geometry}

% =======
% Options
% -------
\newif\if@optionlayout\@optionlayoutfalse
\DeclareOption{layout}{\@optionlayouttrue}

\DeclareOption{a5}{\PassOptionsToPackage{
		resetpaper,
		reset,
		paper=a5paper,
		inner=29mm,
		textwidth=102mm,
		textheight=180mm,
		twoside,
		ignoreall,
	}{geometry}

	\ofoot*{}
	\ifoot*{}
	\cfoot*{}
}

\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{geometry}}
\ProcessOptions\relax

% ==========
% Page setup
% ----------

\RequirePackage{geometry}

% ===========
% Page layout
% -----------

\newcommand{\inlay@layout}{%
	\begin{tikzpicture}[
			remember picture,
			overlay,
		]
		\draw
		[yellow, step=5mm]
		(current page.south west)
		grid
		(current page.north east);

		\draw
		[blue]
		(current page text area.south west)
		rectangle
		(current page text area.north east);

		\draw
		[blue, dashed]
		($(current page text area.south west)-(4mm, 0mm)$)
		rectangle
		(current page text area.north west);

		\draw
		[blue, dashed]
		(current page text area.south east)
		rectangle
		($(current page text area.north east)+(4mm, 0mm)$);

		\draw [red]
		(current page header area.south west)
		rectangle
		(current page header area.north east);

		\draw [red]
		(current page footer area.south west)
		rectangle
		(current page footer area.north east);

		\draw [red]
		(current page marginpar area.south west)
		rectangle
		(current page marginpar area.north east);
	\end{tikzpicture}
}

\if@optionlayout
	\RequirePackage[
		angle=0.0,
		scale=1.0,
		position={current page.south west},
	]{background}
	\RequirePackage[strict]{changepage}
	\RequirePackage{tikz}
	\RequirePackage{tikzpagenodes}
	\usetikzlibrary{calc}

	\SetBgContents{\inlay@layout}
\fi

% ==========
% Title page
% ----------

\RequirePackage{hyperref}
\RequirePackage[
	calc,
	showisoZ,
	showseconds=false,
]{datetime2}
\RequirePackage{gitinfo2}
\RequirePackage[
	type={CC},
	modifier={by-sa},
	version={4.0},
]{doclicense}
\RequirePackage{xstring}

% Convert \gitAuthorIsoDate to UTC without seconds.
\DTMsetstyle{iso}
\StrSubstitute[1]{\gitAuthorIsoDate}{ }{T}[\inlay@AuthorDate]
\StrDel{\inlay@AuthorDate}{ }[\inlay@AuthorDate]
\StrLeft{\inlay@AuthorDate}{22}[\inlay@AuthorDatePrefix]
\StrRight{\inlay@AuthorDate}{2}[\inlay@AuthorDateSuffix]
\DTMsavetimestamp{inlayGitDate}{\inlay@AuthorDatePrefix:\inlay@AuthorDateSuffix}
\DTMtozulu{inlayGitDate}{inlayGitDateZ}

\newcommand{\inlaySourceURL}{https://codeberg.org/corvus-ch/freitag-inlay}
\newcommand{\inlaySourceRevision}{\gitFirstTagDescribe~\DTMuse{inlayGitDateZ}}

\addtokomafont{publishers}{\normalsize}
\newcommand{\inlaytitlepage}[1]{
	\begin{titlepage}
		\subject{Freitag Agenda Inlay}
		\title{#1}
		\author{Christian Häusler}
		\date{\inlaySourceRevision}
		\publishers{\inlaySourceURL}
		\clearpage
		\maketitle
		\thispagestyle{empty}
		\vfill
		\scriptsize\doclicenseThis
	\end{titlepage}
	\cleardoubleoddemptypage
}
