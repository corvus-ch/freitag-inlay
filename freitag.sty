% Title page
% ----------

\RequirePackage{hyperref}
\RequirePackage{gitinfo2}
\RequirePackage[
	type={CC},
	modifier={by-sa},
	version={4.0},
]{doclicense}

\newcommand{\inlaytitlepage}[1]{
	\begin{titlepage}
		\subject{Freitag Agenda Inlay}
		\title{#1}
		\author{Christian Häusler}
		\date{\gitFirstTagDescribe~\gitAuthorIsoDate}
		\publishers{https://codeberg.org/corvus-ch/freitag-inlay}
		\clearpage
		\maketitle
		\thispagestyle{empty}
		\vfill
		\scriptsize\doclicenseThis
	\end{titlepage}
	\cleardoubleoddemptypage
}
